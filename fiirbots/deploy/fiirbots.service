[Unit]
Description=FIIRBots local monitoring dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fiirbots
Group=fiirbots
SupplementaryGroups=dialout gpio
WorkingDirectory=/opt/fiirbots
EnvironmentFile=/etc/fiirbots.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=FIIRBOTS_OBSERVATION_ONLY=1
ExecStart=/opt/fiirbots/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
AmbientCapabilities=CAP_NET_RAW
UMask=0077
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fiirbots
PrivateTmp=true

[Install]
WantedBy=multi-user.target
